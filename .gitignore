# Downloaded setup helpers and unused upstream 7-Zip components.
# Preserve the three runtime files referenced by the app/bundler.
/tools/7zip/*.exe
/tools/7zip/runtime/*
!/tools/7zip/runtime/7z.exe
!/tools/7zip/runtime/7z.dll
!/tools/7zip/runtime/License.txt

