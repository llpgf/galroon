* text=auto
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.nsh text eol=crlf
*.exe binary
*.dll binary
*.ico binary
*.png binary
*.jpg binary
*.woff2 binary
*.crate binary
*.tar.xz binary
*.7z binary
# Bundled license and notice files are hashed byte-for-byte (scripts/generate_notices.py);
# never convert their line endings on checkout.
third-party/** -text
